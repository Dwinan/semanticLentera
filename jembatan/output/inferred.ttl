ex:dipasokOleh a owl:ObjectProperty ;
    rdfs:label "dipasok oleh"@id ;
    rdfs:comment "Menghubungkan catatan penerimaan barang dengan organisasi pemasok yang mengirimkannya."@id ;
    rdfs:domain owl:Thing,
        ex:PenerimaanBarang ;
    rdfs:range schema:Organization ;
    rdfs:subPropertyOf ex:dipasokOleh ;
    owl:equivalentProperty ex:dipasokOleh ;
    owl:inverseOf ex:memasok ;
    owl:sameAs ex:dipasokOleh ;
    schema:name "dipasok oleh"@id .

ex:memasok a owl:ObjectProperty ;
    rdfs:label "memasok"@id ;
    rdfs:comment "Properti kebalikan yang menghubungkan organisasi pemasok ke catatan penerimaan barang."@id ;
    rdfs:domain schema:Organization ;
    rdfs:range owl:Thing,
        ex:PenerimaanBarang ;
    rdfs:subPropertyOf ex:memasok ;
    owl:equivalentProperty ex:memasok ;
    owl:inverseOf ex:dipasokOleh ;
    owl:sameAs ex:memasok ;
    schema:name "memasok"@id .

