xsd:integer a rdfs:Datatype ;
    owl:sameAs xsd:integer .

20 a xsd:decimal,
        xsd:integer ;
    owl:sameAs 20 .

xsd:date a rdfs:Datatype ;
    owl:sameAs xsd:date .

3 a xsd:decimal,
        xsd:integer ;
    owl:sameAs 3 .

schema:Order owl:sameAs schema:Order .

ex:PenerimaanBarang a owl:Class ;
    rdfs:label "Penerimaan Barang Gudang"@id ;
    rdfs:comment "Kejadian pencatatan barang masuk dari pemasok ke gudang beserta kuantitas dan harga beli."@id ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    rdfs:subClassOf owl:Thing,
        ex:PenerimaanBarang ;
    owl:equivalentClass ex:PenerimaanBarang ;
    owl:sameAs ex:PenerimaanBarang ;
    schema:name "Penerimaan Barang Gudang"@id .

2 a xsd:decimal,
        xsd:integer ;
    owl:sameAs 2 .

ex:Barang a owl:Class ;
    rdfs:label "Barang Inventaris Gudang"@id ;
    rdfs:comment "Representasi barang fisik yang tercatat pada sistem inventaris Stokara."@id ;
    rdfs:domain schema:Product ;
    rdfs:range schema:Product ;
    rdfs:subClassOf owl:Thing,
        ex:Barang,
        ex:ProdukJual,
        schema:Product ;
    owl:equivalentClass ex:Barang,
        ex:ProdukJual ;
    owl:sameAs ex:Barang ;
    schema:name "Barang Inventaris Gudang"@id .

ex:ProdukJual a owl:Class ;
    rdfs:label "Produk Jual Kasir"@id ;
    rdfs:comment "Representasi produk dagangan yang tercatat pada sistem kasir Kasira."@id ;
    rdfs:domain schema:Product ;
    rdfs:range schema:Product ;
    rdfs:subClassOf owl:Thing,
        ex:Barang,
        ex:ProdukJual,
        schema:Product ;
    owl:equivalentClass ex:Barang,
        ex:ProdukJual ;
    owl:sameAs ex:ProdukJual ;
    schema:name "Produk Jual Kasir"@id .

rdfs:Datatype owl:sameAs rdfs:Datatype .

schema:Product owl:sameAs schema:Product .

xsd:string a rdfs:Datatype ;
    owl:sameAs xsd:string .

xsd:decimal a rdfs:Datatype ;
    owl:disjointWith xsd:string ;
    owl:sameAs xsd:decimal .

owl:Thing a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass owl:Thing ;
    owl:sameAs owl:Thing .

schema:OrderItem owl:sameAs schema:OrderItem .

