rdfs:label a owl:AnnotationProperty ;
    rdfs:subPropertyOf schema:name ;
    owl:equivalentProperty schema:name ;
    owl:sameAs rdfs:label .

owl:InverseFunctionalProperty owl:sameAs owl:InverseFunctionalProperty .

owl:Nothing a owl:Class ;
    rdfs:subClassOf owl:Nothing,
        owl:Thing,
        ex:Barang,
        ex:PenerimaanBarang,
        ex:ProdukJual,
        schema:Product ;
    owl:equivalentClass owl:Nothing ;
    owl:sameAs owl:Nothing .

owl:ObjectProperty owl:sameAs owl:ObjectProperty .

ex:hargaBeli a owl:DatatypeProperty ;
    rdfs:label "harga beli satuan"@id ;
    rdfs:comment "Harga pokok pembelian per unit barang pada saat penerimaan stok dari pemasok."@id ;
    rdfs:domain owl:Thing,
        ex:PenerimaanBarang ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ex:hargaBeli ;
    owl:equivalentProperty ex:hargaBeli ;
    owl:sameAs ex:hargaBeli ;
    schema:name "harga beli satuan"@id .

ex:marginPerUnit a owl:DatatypeProperty ;
    rdfs:label "margin kotor per unit"@id ;
    rdfs:comment "Selisih antara harga jual ritel di Kasira dan harga beli terakhir di Stokara."@id ;
    rdfs:domain schema:Product ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ex:marginPerUnit ;
    owl:equivalentProperty ex:marginPerUnit ;
    owl:sameAs ex:marginPerUnit ;
    schema:name "margin kotor per unit"@id .

ex:stokMinimum a owl:DatatypeProperty ;
    rdfs:label "stok minimum"@id ;
    rdfs:comment "Ambang batas jumlah stok terendah di gudang sebelum barang wajib dipesan ulang."@id ;
    rdfs:domain schema:Product ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ex:stokMinimum ;
    owl:equivalentProperty ex:stokMinimum ;
    owl:sameAs ex:stokMinimum ;
    schema:name "stok minimum"@id .

